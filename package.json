{
  "name": "devpilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "check": "npm run check -w frontend && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "test:offline": "node scripts/offline-acceptance.mjs",
    "test:live": "node scripts/integration.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
